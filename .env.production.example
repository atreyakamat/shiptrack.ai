# ShipTrack AI - Production Environment Variables Template
# Copy this file to .env before running docker-compose

# Core Security
FLASK_ENV=production
SECRET_KEY=change_this_to_a_long_random_string

# Database
# Note: The docker-compose stack uses an internal postgres network by default.
# Only change this if you are using an external managed database.
DATABASE_URL=postgresql://shiptrack:shiptrack_pass@db:5432/shiptrack

# Initial Admin Credentials (Required for first boot)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_immediately

# Tracking & Adapters
# Set TRACKING_PROVIDER to 'india_post' to attempt live connection (Note: currently blocked by CAPTCHA)
# Set TRACKING_DEMO_MODE to 'false' to disable mock fallback data.
TRACKING_PROVIDER=mock
TRACKING_DEMO_MODE=true

# AI Provider Configuration
# Set AI_PROVIDER to 'openai' or 'ollama' if available, else 'mock'
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
AI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# OCR Engine
# Set OCR_ENGINE to 'easyocr'. Leave empty to mock OCR.
OCR_ENGINE=easyocr

# Background Scheduler
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_MINUTES=60
